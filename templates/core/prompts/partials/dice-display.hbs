{{#if dice.length}}
<div class="prompt-dice-display" data-tooltip="{{diceFormulaLabel}}{{rollDiceLabel}}{{attackerDiceLabel}}{{defenderDiceLabel}}{{damageDiceLabel}}{{intDiceLabel}}" aria-label="{{localize 'ROE_COC7.Dice.DiceUsed'}}">
    {{#each dice}}
    <span class="prompt-die">
        <img src="{{src}}" alt="" />
        {{#if multiple}}<span class="prompt-die-count">&times;{{count}}</span>{{/if}}
    </span>
    {{/each}}
</div>
{{/if}}
