{{#if isResolved}}
{{> roeRollResolvedResult}}
{{else if isPreparingModifiers}}
{{> roeRollModifierPreparation}}
{{else}}
<div class="roe-roll-prompt-frame {{#if compactView}}is-compact{{/if}} {{#unless showPhaseHeaders}}no-phase-headers{{/unless}}" style="background-color: {{themeBackgroundColor}}; background-image: url('modules/narrative-rolls-and-effects/assets/ui/{{theme}}/frame.svg');">
    <button type="button" class="prompt-close-btn" data-action="closePrompt" title="{{localize 'ROE.RollSession.Close'}}">
        <i class="fa-solid fa-xmark"></i>
    </button>

    <header class="prompt-header prompt-drag-handle">
        {{> promptHeader}}
    </header>

    <div class="prompt-detail-area">
        {{> promptDetails}}
    </div>

    <div class="prompt-result-area">
        {{> promptResults}}
    </div>
</div>
{{/if}}
