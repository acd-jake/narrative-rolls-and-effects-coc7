<section class="push-editor-content">
    <p>{{localize "ROE_COC7.PushEditor.Instructions"}}</p>
    <div class="push-editor-skill">
        <label for="push-editor-skill">{{localize "ROE_COC7.PushEditor.Skill"}}</label>
        <select id="push-editor-skill" name="skill">
            {{#each skills}}
            <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
        </select>
    </div>
    <div class="push-editor-skill">
        <label for="push-editor-new-skill">{{localize "ROE_COC7.PushEditor.CustomSkill"}}</label>
        <input id="push-editor-new-skill" name="newSkill" type="text">
        <button type="button" data-action="addSkill">{{localize "ROE_COC7.PushEditor.AddSkill"}}</button>
    </div>
    {{#if hasSkill}}
    <div class="push-editor-entries">
        {{#each entries}}
        <fieldset class="push-editor-card" data-consequence>
            <legend>{{localize "ROE_COC7.PushEditor.Consequence"}} {{number}}</legend>
            <div class="push-editor-heading">
                <label>{{localize "ROE_COC7.PushEditor.EntryTitle"}} <input name="title" type="text" value="{{title}}"></label>
                <label class="push-editor-checkbox"><input name="insane" type="checkbox" {{#if insane}}checked{{/if}}> {{localize "ROE_COC7.PushEditor.Insane"}}</label>
            </div>
            <div class="push-editor-texts">
                <div class="push-editor-field">
                    <span id="push-description-{{@index}}">{{localize "ROE_COC7.PushEditor.Description"}}</span>
                    <prose-mirror name="description" aria-labelledby="push-description-{{@index}}" value="{{description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
                </div>
                <div class="push-editor-field">
                    <span id="push-narration-{{@index}}">{{localize "ROE_COC7.PushEditor.Narration"}}</span>
                    <prose-mirror name="narration" aria-labelledby="push-narration-{{@index}}" value="{{narration}}" toggled>{{{enrichedNarration}}}</prose-mirror>
                </div>
                <div class="push-editor-field push-editor-foreshadowing">
                    <span id="push-foreshadowing-{{@index}}">{{localize "ROE_COC7.PushEditor.Foreshadowing"}}</span>
                    <prose-mirror name="foreshadowing" aria-labelledby="push-foreshadowing-{{@index}}" value="{{foreshadowing}}" toggled>{{{enrichedForeshadowing}}}</prose-mirror>
                </div>
            </div>
            <button class="push-editor-remove" type="button" data-action="remove" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> {{localize "ROE_COC7.PushEditor.Remove"}}</button>
        </fieldset>
        {{/each}}
    </div>
    <div class="push-editor-actions">
        <button type="button" data-action="add">{{localize "ROE_COC7.PushEditor.Add"}}</button>
        <button type="button" data-action="reset">{{localize "ROE_COC7.PushEditor.Reset"}}</button>
        <button type="button" data-action="save">{{localize "ROE_COC7.PushEditor.Save"}}</button>
    </div>
    {{/if}}
</section>