{{#> roePromptLayout}}
{{#*inline "promptHeader"}}
<div class="prompt-actor-name">{{localize "ROE_COC7.RollSession.Types.opposed"}}</div>
{{#if hasPromptDescription}}
<button type="button" class="prompt-skill-name prompt-title-toggle" data-action="toggleDescription"
    aria-expanded="{{#if isDescriptionExpanded}}true{{else}}false{{/if}}"
    title="{{localize 'ROE.Roll.ToggleDescription'}}">
    <span>{{title}}</span>
    <i class="fa-solid fa-circle-info prompt-desc-icon"></i>
</button>
{{else}}
<div class="prompt-skill-name">{{title}}</div>
{{/if}}
{{/inline}}

{{#*inline "promptDetails"}}
{{> roePromptDescription}}

<div class="prompt-sub-box combined-checks-list {{#if outcomeHeadline}}is-subtle{{/if}}">
    <div class="combined-check-row">
        <span>{{first.label}}</span>
        <strong {{#if first.hasRolled}}data-inspect-key="{{first.key}}"{{/if}}>{{#if first.hasRolled}}{{first.total}} vs.
            {{first.targetValue}}{{else}}{{first.targetValue}}%{{/if}}</strong>
    </div>
    {{#if first.canSpendLuck}}
    <button type="button"
        class="prompt-action-btn luck compact {{#if first.isDelegatedToPlayer}}gm-delegated{{/if}}"
        data-action="spendLuck" data-key="{{first.key}}" data-cost="{{first.luckCost}}"
        data-level="{{first.luckTargetLevel}}">
        <i class="fa-solid fa-clover"></i> {{first.label}}: {{localize "ROE_COC7.Chat.SpendLuckImprove"
        level=first.luckTargetLabel cost=first.luckCost}}
    </button>
    <button type="button" class="prompt-action-btn secondary compact {{#if first.isDelegatedToPlayer}}gm-delegated{{/if}}"
        data-action="declineLuck" data-key="{{first.key}}">{{localize "ROE_COC7.RollSession.DeclineLuckBtn"}}</button>
    {{/if}}

    <div class="combined-check-row">
        <span>{{second.label}}</span>
        <strong {{#if second.hasRolled}}data-inspect-key="{{second.key}}"{{/if}}>{{#if second.hasRolled}}{{second.total}} vs.
            {{second.targetValue}}{{else}}{{second.targetValue}}%{{/if}}</strong>
    </div>
    {{#if second.canSpendLuck}}
    <button type="button"
        class="prompt-action-btn luck compact {{#if second.isDelegatedToPlayer}}gm-delegated{{/if}}"
        data-action="spendLuck" data-key="{{second.key}}" data-cost="{{second.luckCost}}"
        data-level="{{second.luckTargetLevel}}">
        <i class="fa-solid fa-clover"></i> {{second.label}}: {{localize "ROE_COC7.Chat.SpendLuckImprove"
        level=second.luckTargetLabel cost=second.luckCost}}
    </button>
    <button type="button" class="prompt-action-btn secondary compact {{#if second.isDelegatedToPlayer}}gm-delegated{{/if}}"
        data-action="declineLuck" data-key="{{second.key}}">{{localize "ROE_COC7.RollSession.DeclineLuckBtn"}}</button>
    {{/if}}
</div>

{{#if canRoll}}
<footer class="prompt-footer pre-roll-controls {{#if isDelegatedToPlayer}}gm-delegated-region{{/if}}">
    {{> roeDiceDisplay dice=rollDice modifierTooltip=modifierDisplay}}

    <button type="button" class="prompt-action-btn roll-now" data-action="executeCombinedRoll">
        <i class="fa-solid fa-dice-d20"></i> {{localize "ROE.Roll.Execute"}}
    </button>
</footer>
{{else}}
{{#unless allRolled}}
<div class="prompt-sub-box">
    <span class="pending-badge">{{localize "ROE_COC7.Combat.Card.AwaitingResolution"}}</span>
</div>
{{/unless}}
{{/if}}

{{#if canPushCombined}}
<div class="prompt-footer">
    {{> roeDiceDisplay dice=rollDice modifierTooltip=modifierDisplay}}
    <button type="button" class="prompt-action-btn push {{#if isDelegatedToPlayer}}gm-delegated{{/if}}"
        data-action="pushRoll" data-key="{{first.key}}">
        <i class="fa-solid fa-rotate-right"></i> {{localize "ROE_COC7.Roll.PushRoll"}}
    </button>
</div>
{{/if}}
{{/inline}}

{{#*inline "promptResults"}}
{{#if outcomeHeadline}}
<div class="prompt-outcome-banner">{{outcomeHeadline}}</div>
{{/if}}
{{> roePushFailurePhase}}

{{#if canResolve}}
<footer class="prompt-footer gm-resolve-footer">
    <button type="button" class="prompt-action-btn primary" data-action="resolveSession">
        <i class="fa-solid fa-gavel"></i> {{localize "ROE.RollSession.ResolveBtn"}}
    </button>
</footer>
{{/if}}
{{/inline}}
{{/roePromptLayout}}
