{{#> roePromptLayout}}
{{#*inline "promptHeader"}}
<div class="prompt-actor-name">{{localize "ROE_COC7.RollSession.Types.opposed"}}</div>
{{#if hasPromptDescription}}
<button type="button" class="prompt-skill-name prompt-title-toggle" data-action="toggleDescription"
    aria-expanded="{{#if isDescriptionExpanded}}true{{else}}false{{/if}}"
    title="{{localize 'ROE.Roll.ToggleDescription'}}">
    <span>{{title}}</span>
    <i class="fa-solid fa-circle-info prompt-desc-icon"></i>
</button>
{{else}}
<div class="prompt-skill-name">{{title}}</div>
{{/if}}
{{/inline}}

{{#*inline "promptDetails"}}
{{> roePromptDescription}}

{{#if phaseSummaryText}}
<div class="prompt-phase-summary">{{phaseSummaryText}}</div>
{{/if}}

<div class="prompt-sub-box opposed-contestants-list">
    {{#each participants}}
    <div class="opposed-contestant-block {{#if isPhaseActive}}is-active{{else}}is-completed{{/if}} {{#if hiddenInCompact}}is-compact-hidden{{/if}}">
        {{#if ../showPhaseHeaders}}
        <div class="combat-phase-header">
            <span class="phase-title">{{localize "ROE_COC7.RollSession.Phases.Contestant" number=phaseNumber}}</span>
            <span class="phase-actor-tag">{{actorName}}</span>
        </div>
        {{/if}}
        <div class="opposed-contestant-row">
            <div class="contestant-info">
                <strong>{{actorName}}</strong>
                <small>{{label}}</small>
            </div>

            {{#unless canRoll}}
            <span class="pending-badge" {{#if hasRolled}}data-inspect-key="{{key}}" {{/if}}>
                {{statusText}}
            </span>
            {{/unless}}
        </div>

        {{#if canRoll}}
        <div class="prompt-player-controls {{#if isDelegatedToPlayer}}gm-delegated-region{{/if}}">
            {{> roeModifierSummary modifierDice=modifierDice modifierDisplay=modifierDisplay}}
            {{> roeDiceDisplay dice=dice modifierTooltip=modifierDisplay}}

            <button type="button" class="prompt-action-btn roll-now compact" data-action="rollContestant" data-key="{{key}}">
                <i class="fa-solid fa-dice-d20"></i> {{label}} ({{targetValue}}%)
            </button>
        </div>
        {{/if}}

        {{#if canPush}}
        <div class="luck-decision-row {{#if isDelegatedToPlayer}}gm-delegated-region{{/if}}">
            {{> roeDiceDisplay dice=dice modifierTooltip=modifierDisplay}}
            <button type="button" class="prompt-action-btn push compact {{#if isDelegatedToPlayer}}gm-delegated{{/if}}"
                data-action="pushRoll" data-key="{{key}}">
                <i class="fa-solid fa-rotate-right"></i> {{localize "ROE_COC7.Chat.PushRoll"}}
            </button>
        </div>
        {{/if}}
    </div>
    {{/each}}
</div>
{{/inline}}

{{#*inline "promptResults"}}
{{> (lookup . "resultPartial")}}
{{> roePushFailurePhase}}

{{#if showPlayerWaitingHint}}
<div class="prompt-phase-summary">
    <i class="fa-solid fa-hourglass-half"></i> {{playerWaitingHint}}
</div>
{{/if}}

{{#if canResolve}}
<footer class="prompt-footer gm-resolve-footer">
    <button type="button" class="prompt-action-btn primary" data-action="resolveSession">
        <i class="fa-solid fa-gavel"></i>
        {{#if showPushFailureWarning}}
        {{#if canViewPushFailure}}{{localize "ROE_COC7.Roll.PushFailureAcknowledge"}}{{else}}{{localize "ROE_COC7.Roll.PushFailureContinue"}}{{/if}}
        {{else}}
        {{localize "ROE.RollSession.ResolveBtn"}}
        {{/if}}
    </button>
</footer>
{{/if}}
{{/inline}}
{{/roePromptLayout}}
