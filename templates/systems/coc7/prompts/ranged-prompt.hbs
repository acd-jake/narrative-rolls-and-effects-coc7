{{#> roePromptLayout}}
{{#*inline "promptHeader"}}
<div class="combat-header-avatars">
    <img class="combatant-avatar" src="{{attackerImg}}" alt="{{attackerName}}" />
    <div class="combat-header-titles">
        {{#if hasPromptDescription}}
        <button type="button" class="prompt-skill-name prompt-title-toggle" data-action="toggleDescription"
            aria-expanded="{{#if isDescriptionExpanded}}true{{else}}false{{/if}}"
            title="{{localize 'ROE.Roll.ToggleDescription'}}">
            <span>{{weaponName}}</span>
            <i class="fa-solid fa-circle-info prompt-desc-icon"></i>
        </button>
        {{else}}
        <div class="prompt-skill-name">{{weaponName}}</div>
        {{/if}}
        {{#if targetName}}
        <div class="prompt-actor-name">{{localize "ROE_COC7.Combat.TargetLabel"}}: {{targetName}}</div>
        {{/if}}
    </div>
</div>
{{/inline}}

{{#*inline "promptDetails"}}
{{> roePromptDescription}}

{{#if phaseSummaryText}}
<div class="prompt-phase-summary">{{phaseSummaryText}}</div>
{{/if}}

<section class="combat-phase-section {{#if isPhaseReaction}}is-active{{else}}is-completed{{/if}} {{#if isPhaseReaction}}{{#unless canActAsTarget}}is-compact-hidden{{/unless}}{{else}}{{#unless isTargetOwner}}is-compact-hidden{{/unless}}{{/if}}">
    <header class="combat-phase-header">
        <span class="phase-title">
            <i class="fa-solid {{#if isPhaseReaction}}fa-person-running{{else}}fa-check-circle{{/if}}"></i>
            {{localize "ROE_COC7.Ranged.Phases.Reaction"}}
        </span>
        <span class="phase-actor-tag">{{targetName}}</span>
    </header>

    {{#if isPhaseReaction}}
    {{#if canActAsTarget}}
    <div class="prompt-player-controls {{#if isTargetDelegated}}gm-delegated-region{{/if}}">
        <div class="section-header">{{localize "ROE_COC7.Ranged.CoverHint"}}</div>
        <div class="reaction-grid-2x2">
            <button type="button" class="tab-btn" data-action="chooseCover" data-cover="true">
                {{localize "ROE_COC7.Ranged.CoverButton"}}
            </button>
            <button type="button" class="tab-btn" data-action="chooseCover" data-cover="false">
                {{localize "ROE_COC7.Ranged.NoCoverButton"}}
            </button>
        </div>
    </div>
    {{/if}}
    {{else}}
    <div class="combined-check-row">
        <span>{{targetName}}</span>
        <strong>{{coverResultText}}</strong>
    </div>
    {{/if}}
</section>

{{#unless isPhaseReaction}}
<section class="combat-phase-section {{#if isPhaseAttack}}is-active{{else}}is-completed{{/if}} {{#if isPhaseAttack}}{{#unless isAttackerOwner}}{{#unless isGM}}is-compact-hidden{{/unless}}{{/unless}}{{else}}{{#unless isAttackerOwner}}is-compact-hidden{{/unless}}{{/if}}">
    <header class="combat-phase-header">
        <span class="phase-title">
            <i class="fa-solid {{#if isPhaseAttack}}fa-crosshairs{{else}}fa-check-circle{{/if}}"></i>
            {{localize "ROE_COC7.Ranged.Phases.Attack"}}
        </span>
        <span class="phase-actor-tag">{{attackerName}}</span>
    </header>

    {{#if tracksAmmo}}
    <div class="combined-check-row ranged-ammo-bar">
        <span><i class="fa-solid fa-bullets"></i> {{localize "ROE_COC7.Ranged.AmmoLabel"}}</span>
        <strong class="{{#if isOutOfAmmo}}is-out-of-ammo{{/if}}">{{ammoCurrent}} / {{ammoMax}}</strong>
    </div>
    {{/if}}

    {{#if isJammed}}
    <div class="prompt-outcome-banner push-failure-warning">
        <i class="fa-solid fa-triangle-exclamation"></i> {{localize "ROE_COC7.Combat.Malfunction"}}
    </div>
    {{/if}}
    {{#if hasRangedShots}}
    <div class="prompt-sub-box ranged-shots-log">
        {{#each rangedShots}}
        <div class="combined-check-row">
            {{#if isTargetSwitch}}
            <span><i class="fa-solid fa-arrows-turn-right"></i> {{localize "ROE_COC7.Ranged.TargetSwitched" target=targetName}}</span>
            <span>-{{bulletsSpent}} {{localize "ROE_COC7.Ranged.BulletsAbbr"}}</span>
            {{else}}
            <span>#{{index}} ({{targetName}})</span>
            <strong class="{{successLevel}}" {{#if rollBreakdown}}data-inspect-key="shot_{{index}}"{{/if}}>
                {{#if malfunction}}
                {{localize "ROE_COC7.Combat.Malfunction"}} ({{total}})
                {{else}}
                {{total}} ({{levelLabel}}){{#if hits}} – {{hits}}× {{localize "ROE_COC7.Ranged.Badges.Hit"}}{{/if}}
                {{/if}}
            </strong>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if isPhaseAttack}}
    <div class="prompt-player-controls {{#if isAttackerDelegated}}gm-delegated-region{{/if}}">
        {{#if targetTookCover}}
        <div class="pending-badge">
            <i class="fa-solid fa-person-running"></i>
            {{localize "ROE_COC7.Ranged.CoverPenaltyNote"}}
        </div>
        {{/if}}

        {{#if hasStartedFiring}}
        <div class="combined-check-row ranged-active-mode-bar">
            <span><strong>{{activeFireModeLabel}}</strong></span>
            {{#if showRemainingShots}}
            <span>{{remainingShotsLabel}}</span>
            {{/if}}
        </div>
        {{else if hasMultipleFireModes}}
        <div class="ranged-firemode-tabs">
            {{#each fireModeOptions}}
            <button type="button" class="tab-btn {{#if active}}active{{/if}}" data-action="setFireMode"
                data-mode="{{id}}">
                {{label}}
            </button>
            {{/each}}
        </div>
        {{/if}}

        {{#if fireModeHint}}
        <div class="pending-badge">{{fireModeHint}}</div>
        {{/if}}

        {{#if showRequiredDifficulty}}
        <div class="difficulty-display">{{requiredDifficultyLabel}}</div>
        {{/if}}

        {{> roeModifierSummary modifierDice=effectiveModifierDice modifierDisplay=effectiveModifierLabel}}
        {{> roeDiceDisplay dice=attackerDice modifierTooltip=effectiveModifierLabel}}

        {{#if canClearMalfunction}}
        <button type="button" class="prompt-action-btn push" data-action="clearMalfunction">
            <i class="fa-solid fa-wrench"></i> {{localize "ROE_COC7.Ranged.ClearMalfunctionBtn"}}
        </button>
        {{/if}}

        {{#if canFireNext}}
        <button type="button" class="prompt-action-btn roll-now" data-action="executeRoll">
            <i class="fa-solid fa-dice-d20"></i> {{attackerRollBtnLabel}}
        </button>
        {{/if}}

        <div class="reaction-grid-2x2">
            {{#if canReload}}
            <button type="button" class="prompt-action-btn secondary compact" data-action="reloadWeapon">
                <i class="fa-solid fa-rotate"></i> {{localize "ROE_COC7.Ranged.ReloadBtn"}}
            </button>
            {{/if}}

            {{#if canSwitchTarget}}
            <button type="button" class="prompt-action-btn secondary compact" data-action="switchRangedTarget">
                <i class="fa-solid fa-crosshairs"></i> {{localize "ROE_COC7.Ranged.SwitchTargetBtn"}}
            </button>
            {{/if}}
        </div>

        {{#if canFinishSeries}}
        <button type="button" class="prompt-action-btn primary compact" data-action="finishRangedAttack">
            <i class="fa-solid fa-flag-checkered"></i> {{localize "ROE_COC7.Ranged.FinishSeriesBtn"}}
        </button>
        {{/if}}
    </div>
    {{else}}
    <div class="combined-check-row">
        <span>{{weaponName}}</span>
        <strong data-inspect-key="attacker">{{attackerResultText}}</strong>
    </div>
    {{/if}}
</section>
{{/unless}}
{{/inline}}
{{#*inline "promptResults"}}
{{#if isPhaseResolution}}
<section class="combat-phase-section is-active">
    <header class="combat-phase-header">
        <span class="phase-title">
            <i class="fa-solid fa-gavel"></i>
            {{localize "ROE_COC7.Ranged.Phases.Resolution"}}
        </span>
    </header>

    {{#if hasDamageStep}}
    <div class="combined-check-row">
        <span><i class="fa-solid fa-burst"></i> {{damageLabel}}</span>
        <strong {{#if damageRolled}}data-inspect-key="damage" {{/if}}>
            {{#if damageRolled}}
            {{#if canViewDamage}}{{damageTotal}} ({{damageFormula}}){{else}}{{localize "ROE.RollSession.HiddenRoll"}}{{/if}}
            {{else}}
            {{#if canViewDamage}}{{damageFormula}}{{else}}<span class="pending-badge">{{localize "ROE.RollSession.PendingRoll"}}</span>{{/if}}
            {{/if}}
        </strong>
    </div>

    {{#if canRollDamage}}
    {{#if canViewDamage}}{{> roeDiceDisplay dice=damageDice modifierTooltip="Damage"}}{{/if}}
    <button type="button" class="prompt-action-btn push {{#if isDamageDelegated}}gm-delegated{{/if}}" data-action="executeDamageRoll">
        <i class="fa-solid fa-dice"></i> {{localize "ROE_COC7.Combat.RollDamageBtn"}}
    </button>
    {{/if}}
    {{/if}}

    {{#if showPlayerWaitingHint}}
    <div class="prompt-phase-summary">
        <i class="fa-solid fa-hourglass-half"></i> {{playerWaitingHint}}
    </div>
    {{else}}
    {{> (lookup . "resultPartial")}}

    {{#if targetTookCover}}
    <div class="prompt-phase-summary">{{localize "ROE_COC7.Ranged.LosesNextAction" actor=targetName}}</div>
    {{/if}}
    {{/if}}

    {{#if canApplyConsequences}}
    <div class="gm-exclusive-zone">
        <div class="gm-eye-badge" title="{{localize 'ROE.RollSession.GmOnlyVisibleHint'}}">
            <i class="fa-solid fa-eye-slash"></i>
        </div>
        <button type="button" class="prompt-action-btn luck" data-action="applyConsequences">
            <i class="fa-solid fa-heart-pulse"></i> {{localize "ROE_COC7.RollSession.ApplyConsequencesBtn"}}
        </button>
    </div>
    {{/if}}

    {{#if canResolve}}
    <footer class="prompt-footer gm-resolve-footer">
        <button type="button" class="prompt-action-btn primary" data-action="resolveSession">
            <i class="fa-solid fa-gavel"></i> {{localize "ROE.RollSession.ResolveBtn"}}
        </button>
    </footer>
    {{/if}}
</section>
{{else if showPlayerWaitingHint}}
<div class="prompt-phase-summary">
    <i class="fa-solid fa-hourglass-half"></i> {{playerWaitingHint}}
</div>
{{/if}}
{{/inline}}
{{/roePromptLayout}}
